# Copy file này thành .env nếu cần cấu hình
PORT=10000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
# Production only: choose a strong password before first deployment.
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Nếu dùng Render, đặt DB_PATH=/data/data.sqlite để lưu trên disk bền vững
# DB_PATH=/data/data.sqlite
